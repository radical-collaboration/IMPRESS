# Both forms deliberately. On Delta `.venv` is a SYMLINK to $WORK_DIR/ve/impress_a on
# NVMe, not a directory, and `.venv/` with the trailing slash matches directories only -
# so the symlink would otherwise show up as an untracked file and get committed.
.venv/
.venv
.venv.*
__pycache__/
*.pyc
.pytest_cache/
# asyncflow writes one of these into CWD per WorkflowEngine run
asyncflow.session.*
# campaign outputs (provenance, artifacts, trust ledger)
campaigns/_runs/
# real tools work in <cwd>/work/<task>; on a laptop cwd is this checkout
work/
# SLURM job output, written to the submit dir by scripts/delta_gpu_run.sh
impress_a_*.out
# setuptools build metadata, regenerated by every `pip install -e .`
src/impress_a.egg-info/
